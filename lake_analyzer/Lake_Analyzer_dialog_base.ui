  <!-- ADVANCED MASKING OPTIONS — expands to the RIGHT of the dialog, so it
       never shifts anything below it. Lake_Analyzer_dialog.py toggles
       groupBox_advanced's visibility and resizes the dialog's *width*
       (setFixedWidth) between the collapsed and expanded values on
       btn_toggle_advanced.toggled — plain, reliable show/hide rather than
       a custom collapsible-widget's own click handling. -->
  <widget class="QPushButton" name="btn_toggle_advanced">
   <property name="geometry"><rect><x>10</x><y>316</y><width>320</width><height>24</height></rect></property>
   <property name="text"><string>▸ Advanced masking options</string></property>
   <property name="checkable"><bool>true</bool></property>
   <property name="checked"><bool>false</bool></property>
  </widget>
  <widget class="QGroupBox" name="groupBox_advanced">
   <property name="geometry"><rect><x>730</x><y>10</y><width>330</width><height>310</height></rect></property>
   <property name="title"><string>Advanced masking options</string></property>

   <widget class="QLabel" name="label_cloudTypes">
    <property name="geometry"><rect><x>10</x><y>24</y><width>300</width><height>16</height></rect></property>
    <property name="font"><font><weight>75</weight><bold>true</bold></font></property>
    <property name="text"><string>Cloud &amp; shadow types to mask</string></property>
   </widget>
   <widget class="QCheckBox" name="cb_cloud_shadows">
    <property name="geometry"><rect><x>20</x><y>46</y><width>250</width><height>18</height></rect></property>
    <property name="text"><string>Cloud shadows</string></property>
    <property name="checked"><bool>true</bool></property>
   </widget>
   <widget class="QCheckBox" name="cb_cloud_high">
    <property name="geometry"><rect><x>20</x><y>68</y><width>250</width><height>18</height></rect></property>
    <property name="text"><string>Clouds high probability</string></property>
    <property name="checked"><bool>true</bool></property>
   </widget>
   <widget class="QCheckBox" name="cb_cloud_med">
    <property name="geometry"><rect><x>20</x><y>90</y><width>250</width><height>18</height></rect></property>
    <property name="text"><string>Clouds medium probability</string></property>
    <property name="checked"><bool>true</bool></property>
   </widget>
   <widget class="QCheckBox" name="cb_cloud_low">
    <property name="geometry"><rect><x>20</x><y>112</y><width>250</width><height>18</height></rect></property>
    <property name="text"><string>Clouds low probability</string></property>
   </widget>
   <widget class="QCheckBox" name="cb_cirrus">
    <property name="geometry"><rect><x>20</x><y>134</y><width>150</width><height>18</height></rect></property>
    <property name="text"><string>Thin cirrus</string></property>
   </widget>
   <widget class="QPushButton" name="btn_select_all">
    <property name="geometry"><rect><x>20</x><y>160</y><width>140</width><height>23</height></rect></property>
    <property name="text"><string>Select all</string></property>
   </widget>
   <widget class="QPushButton" name="btn_unselect_all">
    <property name="geometry"><rect><x>170</x><y>160</y><width>140</width><height>23</height></rect></property>
    <property name="text"><string>Unselect all</string></property>
   </widget>

   <widget class="QLabel" name="label_thresholds">
    <property name="geometry"><rect><x>10</x><y>196</y><width>250</width><height>16</height></rect></property>
    <property name="font"><font><weight>75</weight><bold>true</bold></font></property>
    <property name="text"><string>Cloud thresholds (%)</string></property>
   </widget>
   <widget class="QLabel" name="label_maxTile">
    <property name="geometry"><rect><x>20</x><y>218</y><width>140</width><height>16</height></rect></property>
    <property name="text"><string>Max tile cloud cover</string></property>
   </widget>
   <widget class="QLabel" name="icon_maxTile">
    <property name="geometry"><rect><x>160</x><y>218</y><width>16</width><height>16</height></rect></property>
    <property name="font"><font><bold>true</bold></font></property>
    <property name="styleSheet"><string>color: #0066cc;</string></property>
    <property name="text"><string>ⓘ</string></property>
    <property name="toolTip">
     <string>The maximum whole-tile cloud cover (%) a scene may have, per its catalog metadata, to even be considered a candidate. This is a coarse pre-filter applied before your area of interest is looked at. Set to 100 to accept any tile and let "Max AOI cloud tolerance" do the real filtering for your specific area.</string>
    </property>
   </widget>
   <widget class="QLineEdit" name="lineEdit_maxCloudTile">
    <property name="geometry"><rect><x>180</x><y>216</y><width>70</width><height>22</height></rect></property>
    <property name="text"><string>100</string></property>
   </widget>
   <widget class="QLabel" name="label_maxTol">
    <property name="geometry"><rect><x>20</x><y>246</y><width>160</width><height>16</height></rect></property>
    <property name="text"><string>Max AOI cloud tolerance</string></property>
   </widget>
   <widget class="QLabel" name="icon_maxTol">
    <property name="geometry"><rect><x>185</x><y>246</y><width>16</width><height>16</height></rect></property>
    <property name="font"><font><bold>true</bold></font></property>
    <property name="styleSheet"><string>color: #0066cc;</string></property>
    <property name="text"><string>ⓘ</string></property>
    <property name="toolTip">
     <string>The maximum cloud/shadow cover (%) allowed WITHIN your actual area of interest, measured pixel-by-pixel after download. If exceeded, the run is skipped (a report is still written explaining why). Default 20.</string>
    </property>
   </widget>
   <widget class="QLineEdit" name="lineEdit_maxCloudTol">
    <property name="geometry"><rect><x>205</x><y>244</y><width>70</width><height>22</height></rect></property>
    <property name="text"><string>20</string></property>
   </widget>

   <widget class="QCheckBox" name="cb_restrict_water">
    <property name="geometry"><rect><x>20</x><y>276</y><width>260</width><height>18</height></rect></property>
    <property name="text"><string>Restrict to water pixels only</string></property>
    <property name="checked"><bool>true</bool></property>
   </widget>
   <widget class="QLabel" name="icon_restrict_water">
    <property name="geometry"><rect><x>285</x><y>276</y><width>16</width><height>18</height></rect></property>
    <property name="font"><font><bold>true</bold></font></property>
    <property name="styleSheet"><string>color: #0066cc;</string></property>
    <property name="text"><string>ⓘ</string></property>
    <property name="toolTip">
     <string>Uses the Sentinel-2 SCL band's "Water" class to exclude land, vegetation, and other non-water pixels from the index calculation, so the result reflects only the waterbody itself. Recommended on.</string>
    </property>
   </widget>
  </widget>

